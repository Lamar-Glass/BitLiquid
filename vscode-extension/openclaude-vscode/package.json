{
  "name": "bitliquid-vscode",
  "displayName": "BitLiquid",
  "description": "Practical VS Code companion for BitLiquid with project-aware launch, Control Center, optional Microsoft Foundry / Azure OpenAI terminal env, and chat.",
  "version": "0.2.0",
  "publisher": "devnull-bootloader",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Themes",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:bitliquid.start",
    "onCommand:bitliquid.startInWorkspaceRoot",
    "onCommand:bitliquid.openDocs",
    "onCommand:bitliquid.openSetupDocs",
    "onCommand:bitliquid.openWorkspaceProfile",
    "onCommand:bitliquid.openControlCenter",
    "onCommand:bitliquid.newChat",
    "onCommand:bitliquid.openChat",
    "onCommand:bitliquid.resumeSession",
    "onCommand:bitliquid.abortChat",
    "onCommand:bitliquid.setAzureApiKey",
    "onCommand:bitliquid.clearAzureApiKey",
    "onCommand:bitliquid.configureAzureChat",
    "onCommand:bitliquid.openAzureSettings",
    "onView:bitliquid.controlCenter",
    "onView:bitliquid.chat"
  ],
  "main": "./src/extension.js",
  "files": [
    "README.md",
    "media/**",
    "src/extension.js",
    "src/presentation.js",
    "src/state.js",
    "src/chat/**",
    "themes/**"
  ],
  "contributes": {
    "commands": [
      {
        "command": "bitliquid.start",
        "title": "BitLiquid: Launch in Terminal",
        "category": "BitLiquid"
      },
      {
        "command": "bitliquid.startInWorkspaceRoot",
        "title": "BitLiquid: Launch in Workspace Root",
        "category": "BitLiquid"
      },
      {
        "command": "bitliquid.openDocs",
        "title": "BitLiquid: Open Repository",
        "category": "BitLiquid"
      },
      {
        "command": "bitliquid.openSetupDocs",
        "title": "BitLiquid: Open Setup Guide",
        "category": "BitLiquid"
      },
      {
        "command": "bitliquid.openWorkspaceProfile",
        "title": "BitLiquid: Open Workspace Profile",
        "category": "BitLiquid"
      },
      {
        "command": "bitliquid.openControlCenter",
        "title": "BitLiquid: Open Control Center",
        "category": "BitLiquid"
      },
      {
        "command": "bitliquid.newChat",
        "title": "BitLiquid: New Chat",
        "category": "BitLiquid"
      },
      {
        "command": "bitliquid.openChat",
        "title": "BitLiquid: Open Chat Panel",
        "category": "BitLiquid"
      },
      {
        "command": "bitliquid.resumeSession",
        "title": "BitLiquid: Resume Session",
        "category": "BitLiquid"
      },
      {
        "command": "bitliquid.abortChat",
        "title": "BitLiquid: Abort Generation",
        "category": "BitLiquid"
      },
      {
        "command": "bitliquid.setAzureApiKey",
        "title": "BitLiquid: Set Azure / Foundry API Key (Secret Storage)",
        "category": "BitLiquid"
      },
      {
        "command": "bitliquid.clearAzureApiKey",
        "title": "BitLiquid: Clear Azure / Foundry API Key",
        "category": "BitLiquid"
      },
      {
        "command": "bitliquid.configureAzureChat",
        "title": "BitLiquid: Configure Azure / Foundry Chat (wizard)",
        "category": "BitLiquid"
      },
      {
        "command": "bitliquid.openAzureSettings",
        "title": "BitLiquid: Open Azure / Foundry Settings",
        "category": "BitLiquid"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "bitliquid",
          "title": "BitLiquid",
          "icon": "media/bitliquid.svg"
        }
      ]
    },
    "views": {
      "bitliquid": [
        {
          "id": "bitliquid.chat",
          "name": "Chat",
          "type": "webview"
        },
        {
          "id": "bitliquid.controlCenter",
          "name": "Control Center",
          "type": "webview"
        }
      ]
    },
    "keybindings": [
      {
        "command": "bitliquid.openChat",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l"
      }
    ],
    "configuration": {
      "title": "BitLiquid",
      "properties": {
        "bitliquid.launchCommand": {
          "type": "string",
          "default": "bitliquid",
          "description": "Command run in the integrated terminal when launching BitLiquid."
        },
        "bitliquid.terminalName": {
          "type": "string",
          "default": "BitLiquid",
          "description": "Integrated terminal tab name for BitLiquid sessions."
        },
        "bitliquid.useOpenAIShim": {
          "type": "boolean",
          "default": false,
          "description": "Optionally set CLAUDE_CODE_USE_OPENAI=1 in launched BitLiquid terminals when Azure injection is off or incomplete."
        },
        "bitliquid.azure.enabled": {
          "type": "boolean",
          "default": false,
          "description": "When true, launch injects Microsoft Foundry / Azure OpenAI-compatible chat env (OPENAI_* + AZURE_OPENAI_API_VERSION) into the BitLiquid terminal."
        },
        "bitliquid.azure.endpoint": {
          "type": "string",
          "default": "",
          "markdownDescription": "Azure resource base URL for OpenAI-compatible chat (example: `https://YOUR_RESOURCE.openai.azure.com`). Do not put `api-version` here; use **BitLiquid: Azure API Version**."
        },
        "bitliquid.azure.apiVersion": {
          "type": "string",
          "default": "2024-12-01-preview",
          "description": "Azure API version for chat completions (AZURE_OPENAI_API_VERSION)."
        },
        "bitliquid.azure.deployment": {
          "type": "string",
          "default": "",
          "markdownDescription": "Azure deployment name (maps to `OPENAI_MODEL` for the OpenAI shim)."
        },
        "bitliquid.azure.forceAzureUrlStyle": {
          "type": "boolean",
          "default": true,
          "description": "Sets OPENAI_AZURE_STYLE=1 so deployment URLs and api-key header work on Foundry and non-standard Azure hosts."
        },
        "bitliquid.azure.apiKey": {
          "type": "string",
          "default": "",
          "markdownDescription": "Optional API key in settings (not recommended). Prefer **BitLiquid: Set Azure / Foundry API Key**. Secret wins if both are set."
        },
        "bitliquid.permissionMode": {
          "type": "string",
          "default": "acceptEdits",
          "enum": ["default", "acceptEdits", "bypassPermissions", "plan"],
          "enumDescriptions": [
            "Prompt for permission on each tool use (requires manual approval)",
            "Auto-approve file edits, prompt for other operations (recommended)",
            "Auto-approve all operations without prompting",
            "Read-only mode — no file modifications allowed"
          ],
          "description": "Permission mode for chat sessions. Controls which tool operations are auto-approved."
        }
      }
    },
    "themes": [
      {
        "label": "BitLiquid Terminal Black",
        "uiTheme": "vs-dark",
        "path": "./themes/BitLiquid-Terminal-Black.json"
      }
    ]
  },
  "scripts": {
    "test": "bun test src",
    "lint": "node scripts/lint.js",
    "package": "npx @vscode/vsce package --no-dependencies"
  },
  "keywords": [
    "bitliquid",
    "terminal",
    "theme",
    "cli",
    "llm",
    "azure",
    "foundry"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Lamar-Glass/BitLiquid"
  },
  "license": "MIT"
}
